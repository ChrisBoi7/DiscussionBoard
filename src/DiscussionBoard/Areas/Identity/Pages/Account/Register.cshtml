@page
@model DiscussionBoard.Areas.Identity.Pages.Account.RegisterModel
@using DiscussionBoard.Services
@{ ViewData["Title"] = "Register"; }
<h1>Register</h1><div class="row"><div class="col-md-6">
<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <h2>Create a new account</h2><hr />
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="form-floating mb-3"><input asp-for="Input.Email" class="form-control" autocomplete="username" /><label asp-for="Input.Email"></label><span asp-validation-for="Input.Email" class="text-danger"></span></div>
    <div class="form-floating mb-3"><input asp-for="Input.Password" class="form-control" autocomplete="new-password" /><label asp-for="Input.Password"></label><span asp-validation-for="Input.Password" class="text-danger"></span></div>
    <div class="form-floating mb-3"><input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" /><label asp-for="Input.ConfirmPassword"></label><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Input.Profile.DisplayName" class="form-label"></label><input asp-for="Input.Profile.DisplayName" class="form-control" /><span asp-validation-for="Input.Profile.DisplayName" class="text-danger"></span></div>
    <fieldset><legend>Choose an avatar</legend>
    @foreach (var option in AvatarCatalog.Options) {
        <div class="form-check form-check-inline"><input class="form-check-input" type="radio" asp-for="Input.Profile.AvatarId" id="avatar-@option.Id" value="@option.Id" /><label class="form-check-label" for="avatar-@option.Id"><img src="@AvatarCatalog.ImagePath(option.Id)" alt="@option.DisplayName avatar" width="64" height="64" /> @option.DisplayName</label></div>
    }
    <span asp-validation-for="Input.Profile.AvatarId" class="text-danger"></span></fieldset>
    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary mt-3">Register</button>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
