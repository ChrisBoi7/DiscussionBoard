@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel
@{ ViewData["Title"] = Model.Forum.Name; }
<h1>@Model.Forum.Name</h1><p>@Model.Forum.Description</p>
@if (User.Identity?.IsAuthenticated == true) { <a class="btn btn-primary mb-3" asp-page="/Discussions/Create" asp-route-forumId="@Model.Forum.Id">Start A Discussion</a> }
else { <p>Login to start a discussion.</p> }
@foreach (var thread in Model.Threads) { <partial name="/Pages/Forums/_ThreadCard.cshtml" model="thread" /> }
