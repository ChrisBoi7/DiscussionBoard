@page "/Discussion/{threadId:int}/Post/Edit/{postId:int}"
@model DiscussionBoard.Pages.EditPostModel
@{ ViewData["Title"] = "Edit reply"; }
<h1>Edit reply</h1>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div>
 <label asp-for="Input.Title"></label><input asp-for="Input.Title" class="form-control" />
 <label asp-for="Input.Content"></label><textarea asp-for="Input.Content" class="form-control"></textarea>
 <button class="btn btn-primary mt-3">Save</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
